# Copy to .env on the server. Never commit the real file.
POSTGRES_PASSWORD=change-me
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_ALLOWED_HOSTS=media.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://media.example.com
# base64 of 32 random bytes:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
KYC_ENCRYPTION_KEY=
PLATFORM_FEE_PERCENT=5
BUYER_PROTECTION_HOURS=72
UNVERIFIED_TRADE_LIMIT=50000
# Test server only: credit deposits instantly and show OTP codes on screen (no gateways / SMS yet).
PAYMENTS_SANDBOX=1
OTP_ECHO=1
# Email (SMTP). Leave EMAIL_HOST empty to print emails to the log instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Media <no-reply@sell.agamirshwapno.site>
# SMS gateway (BulkSMSBD-style form POST: api_key, senderid, number, message). Empty = SMS skipped.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Online payment gateways — each turns on only when its keys are set. See docs/payments.md.
PUBLIC_BASE_URL=https://media.example.com
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_SERVER_IP=
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_SANDBOX=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
